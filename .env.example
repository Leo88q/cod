# Скопируй в .env и заполни
BOT_TOKEN=123456:ABC-from-BotFather
# Внешний URL бэкенда. Для preview: https://<порт>-<sandboxId>.e2b.app
PUBLIC_URL=http://localhost:8000
# WEBAPP_URL=https://<порт>-<sandboxId>.e2b.app/app
SHOP_COMMISSION_PCT=10
SUPPORT_CONTACT=@scena_support

# Shared SQLite quotas (all workers must use the same local DB_PATH)
RATE_LIMIT_PER_MIN=60
RATE_LIMIT_USER_PER_MIN=60
RATE_LIMIT_GIFTS_PER_MIN=10
RATE_LIMIT_SUGGEST_PER_MIN=5

# REQUIRED in production: generate with python -c 'import secrets; print(secrets.token_urlsafe(48))'
# Same secret across API workers; changing it revokes all existing media links.
MEDIA_SIGNING_SECRET=
MEDIA_URL_TTL_SECONDS=900

# Dedicated production worker: API must use SCHEDULER_ENABLED=0.
SCHEDULER_ENABLED=1
# Production compose only: DNS name without scheme; PUBLIC_URL must be https://this-name
PUBLIC_DOMAIN=
RATE_LIMIT_UPLOAD_PER_MIN=10

# Actual operator details; preflight fails if these are empty. Do not invent them.
OPERATOR_NAME=
OPERATOR_INN=
OPERATOR_CONTACT=
HOSTING_REGION=
POLICY_VERSION=2026-11-04
AUDIT_RETENTION_DAYS=90
# One-shot monitor, preferably scheduled on a separate host:
# MONITOR_BASE_URL=https://your-domain
# Use the separate MONITOR_TOKEN below, not the full admin credential.
# MONITOR_STATE_PATH=/var/lib/scena-monitor/state.json
# MONITOR_MAX_PENDING=200
# Generate a separate read-only credential for /api/admin/metrics.
MONITOR_TOKEN=

# MONITOR_MAX_PENDING_AGE=3600
